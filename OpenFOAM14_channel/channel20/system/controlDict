FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application     foamRun;
solver          incompressibleFluid;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         3000;
deltaT          1;
writeControl    timeStep;
writeInterval   100;
purgeWrite      2;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
runTimeModifiable true;
